<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Icono de la aplicación: el mismo logo de inicio (Recursos\app.ico) -->
    <ApplicationIcon>Recursos\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Catálogo CSV ubicado junto a la solución. Se publica con nombre ASCII
         (catalogo_cubo.csv) junto al .exe: los instaladores pueden descomprimir
         con otro codepage y el nombre original lleva Á y ñ. -->
    <None Include="..\*.csv" Link="catalogo_cubo.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <!-- Recursos gráficos: se copian junto al .exe preservando la subcarpeta Recursos\,
         porque las rutas de logo ahora son fijas (sin búsquedas ascendentes).
         Se copia .ico para que el Setup y los accesos directos tengan su icono.
         El logo de las ventanas NO se lee de disco: va embebido en RecursosBase64
         y en los .resx, así que la app no depende de estas imágenes en runtime. -->
    <None Update="Recursos\*.jpg;Recursos\*.png;Recursos\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>